const DISCORD_FIELD_LIMIT = 1024;
const DISCORD_CONTENT_LIMIT = 2000;

type TicketNotice = {
  id: string;
  project: string;
  description: string;
};

export async function notifyDiscord(
  ticket: TicketNotice,
): Promise<{ ok: true } | { ok: false; error: string }> {
  const webhookUrl = process.env.DISCORD_WEBHOOK_URL?.trim();
  if (!webhookUrl) {
    return { ok: false, error: "DISCORD_WEBHOOK_URL is not set." };
  }

  const roleId = readRoleId(process.env.DISCORD_BOT_ROLE_ID);
  const content = [
    roleId ? `<@${roleId}>` : "",
    "New support ticket",
    `Ticket ID: ${ticket.id}`,
    `Project Name: ${ticket.project}`,
    `Bug Description: ${ticket.description}`,
  ]
    .filter(Boolean)
    .join("\n")
    .slice(0, DISCORD_CONTENT_LIMIT);

  const descriptionFields = chunk(ticket.description, DISCORD_FIELD_LIMIT).map(
    (value, index) => ({
      name: index === 0 ? "Bug Description" : `Bug Description (${index + 1})`,
      value,
    }),
  );

  try {
    const response = await fetch(webhookUrl, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        content,
        allowed_mentions: roleId ? { users: [roleId] } : { parse: [] },
        embeds: [
          {
            title: "New support ticket",
            fields: [
              { name: "Ticket ID", value: ticket.id },
              { name: "Project Name", value: ticket.project },
              ...descriptionFields,
            ],
          },
        ],
      }),
      signal: AbortSignal.timeout(10_000),
    });

    if (!response.ok) {
      return {
        ok: false,
        error: `Discord responded with ${response.status}.`,
      };
    }

    return { ok: true };
  } catch (error) {
    const message = error instanceof Error ? error.message : "Webhook request failed.";
    return { ok: false, error: message };
  }
}

function readRoleId(value: string | undefined) {
  const roleId = value?.trim() ?? "";
  return /^\d{5,25}$/.test(roleId) ? roleId : undefined;
}

function chunk(value: string, size: number) {
  if (!value) return ["—"];
  const parts: string[] = [];
  for (let index = 0; index < value.length; index += size) {
    parts.push(value.slice(index, index + size));
  }
  return parts;
}
</file>

