<file path="src/lib/tickets.ts">
export const PROJECT_NAMES = ["Site 1", "Site 2", "Site 3"] as const;
export const TICKET_STATUSES = ["OPEN", "TRIAGED", "IN_PROGRESS", "RESOLVED"] as const;

export type ProjectName = (typeof PROJECT_NAMES)[number];
export type TicketStatus = (typeof TICKET_STATUSES)[number];

export type TicketView = {
  id: string;
  project: string;
  description: string;
  status: TicketStatus;
  resolutionSummary: string | null;
  createdAt: string;
};

const MAX_DESCRIPTION_LENGTH = 4000;
const MAX_RESOLUTION_SUMMARY_LENGTH = 4000;

export function isProjectName(value: string): value is ProjectName {
  return (PROJECT_NAMES as readonly string[]).includes(value);
}

export function isTicketStatus(value: string): value is TicketStatus {
  return (TICKET_STATUSES as readonly string[]).includes(value);
}

export function parseTicketInput(
  body: unknown,
): { ok: true; project: ProjectName; description: string } | { ok: false; error: string } {
  if (!body || typeof body !== "object") {
    return { ok: false, error: "Request body must be JSON." };
  }

  const record = body as { project?: unknown; description?: unknown };

  if (typeof record.project !== "string" || !isProjectName(record.project)) {
    return { ok: false, error: "Choose Site 1, Site 2, or Site 3." };
  }

  if (typeof record.description !== "string") {
    return { ok: false, error: "Describe the bug." };
  }

  const description = record.description.trim();
  if (!description) {
    return { ok: false, error: "Describe the bug." };
  }
  if (description.length > MAX_DESCRIPTION_LENGTH) {
    return {
      ok: false,
      error: `Description must be ${MAX_DESCRIPTION_LENGTH} characters or fewer.`,
    };
  }

  return { ok: true, project: record.project, description };
}

export function parseStatusInput(
  body: unknown,
):
  | { ok: true; status: TicketStatus; resolutionSummary?: string | null }
  | { ok: false; error: string } {
  if (!body || typeof body !== "object") {
    return { ok: false, error: "Request body must be JSON." };
  }

  const record = body as { status?: unknown; resolutionSummary?: unknown };

  if (typeof record.status !== "string" || !isTicketStatus(record.status)) {
    return {
      ok: false,
      error: `Status must be one of: ${TICKET_STATUSES.join(", ")}.`,
    };
  }

  let resolutionSummary: string | null | undefined;
  if (record.resolutionSummary !== undefined) {
    if (record.resolutionSummary === null) {
      resolutionSummary = null;
    } else if (typeof record.resolutionSummary === "string") {
      const trimmed = record.resolutionSummary.trim();
      if (trimmed.length > MAX_RESOLUTION_SUMMARY_LENGTH) {
        return {
          ok: false,
          error: `Resolution summary must be ${MAX_RESOLUTION_SUMMARY_LENGTH} characters or fewer.`,
        };
      }
      resolutionSummary = trimmed || null;
    } else {
      return { ok: false, error: "Resolution summary must be a string." };
    }
  }

  return { ok: true, status: record.status, resolutionSummary };
}

export function serializeTicket(ticket: {
  id: string;
  project: string;
  description: string;
  status: TicketStatus;
  resolutionSummary: string | null;
  createdAt: Date;
}): TicketView {
  return {
    id: ticket.id,
    project: ticket.project,
    description: ticket.description,
    status: ticket.status,
    resolutionSummary: ticket.resolutionSummary,
    createdAt: ticket.createdAt.toISOString(),
  };
}

export { MAX_DESCRIPTION_LENGTH };
