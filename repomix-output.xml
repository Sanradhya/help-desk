import { getPrisma } from "@/lib/prisma";
import { parseStatusInput, serializeTicket } from "@/lib/tickets";

async function readJson(request: Request) {
  try {
    return await request.json();
  } catch {
    return null;
  }
}

export async function PATCH(
  request: Request,
  context: { params: Promise<{ id: string }> },
) {
  const { id } = await context.params;
  const parsed = parseStatusInput(await readJson(request));
  if (!parsed.ok) {
    return Response.json({ error: parsed.error }, { status: 400 });
  }

  try {
    const prisma = getPrisma();
    const existing = await prisma.ticket.findUnique({ where: { id } });
    if (!existing) {
      return Response.json({ error: "Ticket not found." }, { status: 404 });
    }

    const ticket = await prisma.ticket.update({
      where: { id },
      data: {
        status: parsed.status,
        ...(parsed.resolutionSummary !== undefined
          ? { resolutionSummary: parsed.resolutionSummary }
          : {}),
      },
    });

    return Response.json({ ticket: serializeTicket(ticket) });
  } catch (error) {
    console.error("Failed to update ticket", error);
    return Response.json({ error: "Could not update the ticket." }, { status: 500 });
  }
}
